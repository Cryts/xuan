  },
  {
    "id": "dest_keep_dull",
    "name": "守拙者",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "origin_orphan" },
        { "type": "flag", "ref": "trait_loyal_hound" }
      ]

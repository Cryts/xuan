    "rule_rewrite": "宗门与教会的追缉手段对你无效；所有以「出身来历」为门槛的机缘同时对你关闭，包括传人、衣钵、真传三类。",
    "effects": [
      { "type": "set_flag", "key": "destiny_rootless" },
      { "type": "add_var", "key": "exposure", "delta": -12 },
      { "type": "add_var", "key": "favor", "delta": -8 }

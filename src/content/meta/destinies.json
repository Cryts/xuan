            { "type": "flag", "ref": "trait_patron_favor" }
          ]
        }
      ]
    },
    "rule_rewrite": "因果债务可按比例折算为战力与判定加成。开局负债越高，前期越强；每局结束时按剩余债务结算结局评级。",
    "effects": [
      { "type": "set_flag", "key": "destiny_debt_master" },
      { "type": "add_var", "key": "debt", "delta": 10 },
      { "type": "modify_power_index", "delta": 15 }
    ],
    "desc": "欠得越多，别人越不敢让你死。这门生意，你做得很熟练。"
  },
  {
    "id": "dest_under_lamp",
    "name": "灯下黑",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "lamp_rite" },
        { "type": "flag", "ref": "trait_gap_eye" }
      ]
    },
    "rule_rewrite": "追查与搜捕类事件对你的判定降低三成。代价是你在暗处获得的情报同样减少——你只能看见灯照到的地方。",
    "effects": [
      { "type": "set_flag", "key": "destiny_under_lamp" },
      { "type": "add_var", "key": "exposure", "delta": -8 },
      { "type": "add_attr", "key": "insight", "delta": -1 }

[
  {
    "id": "dest_reborn",
    "name": "重生者",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "trait_past_life_memory" },
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "origin_orphan" },
            { "type": "flag", "ref": "origin_castoff" },
            { "type": "flag", "ref": "origin_beggar" }
          ]
        }
      ]
    },
    "rule_rewrite": "开局多出一段前世记忆：早期节点中，凡是与你记忆吻合的判定额外获得优势。但你会不自觉说出「还没发生的事」，疑心由此而生。",
    "effects": [
      { "type": "set_flag", "key": "destiny_reborn" },
      { "type": "add_attr", "key": "insight", "delta": 2 },
      { "type": "add_var", "key": "exposure", "delta": -5 },
      { "type": "unlock_title", "ref": "title_reborn" }
    ],
    "desc": "你记得一些不该记得的事。记得最清楚的那一件，是你自己的死法。"
  },
  {
    "id": "dest_outsider",
    "name": "局外人",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "origin_outlander" },
        { "type": "flag", "ref": "no_register" }
      ]
    },
    "rule_rewrite": "本体系的强制事件（清算、审查、征召、清算式追杀）对你首次失效。代价是你被所有阵营的馈赠名单排除在外。",
    "effects": [
      { "type": "set_flag", "key": "destiny_outsider" },
      { "type": "add_var", "key": "exposure", "delta": -10 },
      { "type": "add_var", "key": "favor", "delta": -10 }
    ],
    "desc": "你不在任何一本册子上。册子管不到你，册子里的好处也轮不到你。"
  },
  {
    "id": "dest_defier",
    "name": "逆命者",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "trait_defiant_bone" },
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "origin_convict" },
            { "type": "flag", "ref": "origin_castoff" },
            { "type": "flag", "ref": "origin_orphan" }
          ]
        }
      ]
    },
    "rule_rewrite": "天劫类判定失败时可重掷一次。每次重掷累加天债，且不可连续重掷——天道也记账。",
    "effects": [
      { "type": "set_flag", "key": "destiny_defier" },
      { "type": "add_var", "key": "debt", "delta": 5 },
      { "type": "add_attr", "key": "temper", "delta": 2 }
    ],
    "desc": "别人渡劫靠备货，你渡劫靠不认。天雷劈下来的时候，你抬着头。"
  },
  {
    "id": "dest_relic_picker",
    "name": "拾遗人",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "origin_fallen_sect" },
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "trait_gap_eye" },
            { "type": "flag", "ref": "trait_alchemy_gift" }
          ]
        }
      ]
    },
    "rule_rewrite": "遗府与秘境类事件的收获提升一档；但每次额外收获都会同步写入暴露度，藏不住第二次。",
    "effects": [
      { "type": "set_flag", "key": "destiny_relic_picker" },
      { "type": "add_var", "key": "rare_mat", "delta": 4 },
      { "type": "add_var", "key": "exposure", "delta": 6 }
    ],
    "desc": "你捡别人不要的东西，并且总能捡对。破门而入的人死了，你跟在后面活着。"
  },
  {
    "id": "dest_twin_soul",
    "name": "双生魂",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "old_soul" },
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "trait_dream_walker" },
            { "type": "flag", "ref": "trait_unbroken_daoheart" }
          ]
        }
      ]
    },
    "rule_rewrite": "神魂类污染减半。每次失控会短暂切换人格：数节点内六维属性的权重互换，判定依据随之改变。",
    "effects": [
      { "type": "set_flag", "key": "destiny_twin_soul" },
      { "type": "add_var", "key": "corruption", "delta": -10 }
    ],
    "desc": "你脑子里住着另一个人。他比你懂得多，也比你更想活。"
  },
  {
    "id": "dest_hidden_edge",
    "name": "藏锋者",
    "combo": {
      "type": "all",
      "of": [
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "origin_castoff" },
            { "type": "flag", "ref": "origin_beggar" }
          ]
        },
        { "type": "flag", "ref": "trait_unbound_register" }
      ]
    },
    "rule_rewrite": "常规手段无法识破你的真实境界与底牌。但一旦你主动全力出手，隐蔽永久失效，且无法再恢复。",
    "effects": [
      { "type": "set_flag", "key": "destiny_hidden_edge" },
      { "type": "add_var", "key": "exposure", "delta": -15 }
    ],
    "desc": "所有人对你的评估都低了一档。这正是你要的——直到你需要他们高估你。"
  },
  {
    "id": "dest_debt_master",
    "name": "债多不压身",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "origin_convict" },
        {
          "type": "any",
          "of": [

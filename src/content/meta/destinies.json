  },
  {
    "id": "dest_night_walker",
    "name": "长夜行者",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "night_errand" },
        { "type": "flag", "ref": "trait_dream_walker" }
      ]
    },
    "rule_rewrite": "夜间与阴属判定获得加成，隐蔽类判定尤甚；白昼行动时寿元持续流失，且无法通过闭关弥补。",
    "effects": [
      { "type": "set_flag", "key": "destiny_night_walker" },
      { "type": "modify_power_index", "delta": 10 },
      { "type": "add_var", "key": "lifespan", "delta": -5 }
    ],
    "desc": "太阳一出你就犯困。你这一生最好的事，都发生在别人睡着的时候。"
  },
  {
    "id": "dest_stone_heart",

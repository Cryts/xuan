      "type": "all",
      "of": [
        { "type": "flag", "ref": "origin_beast_blood" },
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "trait_sword_bone" },
            { "type": "flag", "ref": "trait_defiant_bone" }

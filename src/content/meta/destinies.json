    },
    "rule_rewrite": "每局随机获知三条谶语：两条为真，一条为假。假的那条不会报错，只会把你推往最坏的那条结局线。",
    "effects": [
      { "type": "set_flag", "key": "destiny_omen_child" },
      { "type": "add_attr", "key": "luck", "delta": 2 },
      { "type": "unlock_codex", "ref": "codex_omen" }

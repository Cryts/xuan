  },
  {
    "id": "dest_last_page",
    "name": "残卷一页",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "inherited_manual" },
        {
          "type": "any",
          "of": [
            { "type": "flag", "ref": "trait_alchemy_gift" },
            { "type": "flag", "ref": "trait_past_life_memory" }
          ]
        }
      ]

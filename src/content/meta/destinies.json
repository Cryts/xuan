    "desc": "最亮的地方最容易被忽略。你在那里站了很多年，没人低头找过。"
  },
  {
    "id": "dest_omen_child",
    "name": "谶言之子",
    "combo": {
      "type": "all",
      "of": [
        { "type": "flag", "ref": "heaven_watched" },
        { "type": "flag", "ref": "origin_exiled_immortal" }

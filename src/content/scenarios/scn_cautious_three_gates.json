  "rules_stated": [
    "追你的人不歇脚：你慢一刻，他就近一程。",
    "前面三道关口，过一道留一样东西——留什么，你定。",
    "出了第三道口就是别家的地界，他的人追不进去。"
  ],
  "rules_hidden": [
    {
      "id": "rule_gate_is_count",
      "hint": "三道口子不是三道门，是三笔数：他数的不是你走了哪条路，是你还剩几道没走。走得越早，他在后头数得越乱。",
      "reveal": {
        "type": "node_count",
        "op": ">=",
        "value": 2
      }
    },
    {
      "id": "rule_toll_is_name",
      "hint": "关口收的不是钱，是「你是谁」：报了真名就等于把人留下了，报个假名，他得先去查。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "affordance",
            "ref": "匿形"
          },
          {
            "type": "attr",
            "key": "insight",
            "op": ">=",
            "value": 45
          }
        ]
      }
    }
  ],
  "forbidden": [

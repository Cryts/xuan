  "rules_stated": [
    "你与三处各持一枚传音符，符只单向——你听得见他们，他们听不见你。",
    "一刻只能取一枚符，其余两符此刻之音就此遗失。",
    "未应答者视同弃之，被弃者见则索命。"
  ],
  "rules_hidden": [
    {
      "id": "rule_silence_no_trace",
      "hint": "『应答』须出声。你从未出过声——他们凭什么知道你漏听了哪一枚？",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 65
      }
    },
    {
      "id": "rule_echo_reverse",
      "hint": "符中留声可倒着听。先听末刻，便知该取哪一枚。",
      "reveal": {
        "type": "attr",
        "key": "insight",
        "op": ">=",
        "value": 60
      }
    },
    {
      "id": "rule_borrowed_ear",
      "hint": "『单向』说的是你的声音传不出。可符是死物——谁把耳朵贴上去，谁就听得见。",
      "reveal": {

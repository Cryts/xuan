  "rules_stated": [
    "论道三场，各出三问，答不上者负。",
    "各守本途之法——出手时越法者判负。",
    "胜者取道果，负者留一物于台上。"
  ],
  "rules_hidden": [
    {
      "id": "rule_law_is_act",
      "hint": "『守本途之法』判的是你出手那一刻所运的法，不是你身上带着的法。带而不运，不算越法。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "attr",
            "key": "wits",
            "op": ">=",
            "value": 48
          },
          {
            "type": "learned_rule",
            "pack": "cautious",
            "ref": "rule_borrowed_ear"
          }
        ]
      }
    },
    {
      "id": "rule_question_not_test",
      "hint": "『问』是问，不是考。他答不出你所问，与他不知道，是两回事。",
      "reveal": {
        "type": "attr",
        "key": "charm",
        "op": ">=",
        "value": 46
      }
    },
    {
      "id": "rule_left_thing_any",
      "hint": "『留一物』——物是谁的不论。留在台上，就算留了。",

  "rules_stated": [
    "鬼市只认令不认人，掌中无令者入市即化灰。",
    "市中不问来路，不问去处，问者化灰。",
    "市中所购之物，须待离市方可启封。"
  ],
  "rules_hidden": [
    {
      "id": "rule_wax_not_seal",
      "hint": "『认令』认的是令上那一点朱漆。漆是死的，谁都能烫。你掌中那一枚，本就是仿的。",
      "reveal": {
        "type": "attr",
        "key": "insight",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_ask_is_speech",
      "hint": "『不问来路』禁的是开口相问，不是抬眼相看——看是不要钱的。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_bridge_is_border",
      "hint": "市界不在摊子，在桥。桥那头檐下的水洼，已经不是鬼市的地了。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "known_rule",
            "ref": "rule_wax_not_seal"
          },
          {
            "type": "affordance",
            "ref": "启户"
          }
        ]
      }
    }
  ],
  "forbidden": [
    "在市中启封所购之物",
    "以法照人面目",
    "于市中呼人名姓"
  ],

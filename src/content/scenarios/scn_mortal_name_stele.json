  "rules_stated": [
    "碑上刻你此行功过之名次，功过愈著，名次愈高。",
    "名次高者，守碑人出手愈重——碑不试无名之辈。",
    "碑不可毁。毁碑者名次归零，此生不得再入碑下。"
  ],
  "rules_hidden": [
    {
      "id": "rule_rank_lags",
      "hint": "碑刻的是你上一程的功过，它慢你一站。此刻你在碑上的名次，是离开此地之后的你。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 46
      }
    },
    {
      "id": "rule_unnamed",
      "hint": "『归零』不是抹去，是从未有名。碑上本就有许多空处——空处不算名次。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "flag",
            "ref": "saw_blank_line"
          },
          {
            "type": "attr",
            "key": "insight",
            "op": ">=",
            "value": 45
          }
        ]
      }
    },
    {
      "id": "rule_keeper_blind",
      "hint": "守碑人按名次出招，可他并没见过你。他打的是碑上那个名字——那名字是谁的，他分不出来。",
      "reveal": {
        "type": "known_rule",
        "ref": "rule_rank_lags"
      }
    }
  ],
  "forbidden": [
    "毁碑",
    "以他人之名刻碑",
    "对守碑人自陈名次"
  ],

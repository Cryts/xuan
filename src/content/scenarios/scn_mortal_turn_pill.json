  "rules_stated": [
    "炉中丹成于九转，每投一味药便记一转，九转既满，丹成鼎封。",
    "一转之内只可投一味，投重则整炉尽废。",
    "鼎下真火不可离人，人离则火熄，火熄则前功尽弃。"
  ],
  "rules_hidden": [
    {
      "id": "rule_turn_is_voice",
      "hint": "『记转』记的是报药之声，不是投药之手。不报名的药，鼎不认它。",
      "reveal": {
        "type": "attr",
        "key": "insight",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_fire_second_hand",
      "hint": "『不可离人』之『人』，不专指你一个。鼎侧另有一个人守着，火就不算离人。",
      "reveal": {
        "type": "relation",
        "kind": "护道人",
        "exists": true
      }
    },
    {
      "id": "rule_ninth_is_shape",
      "hint": "九转所求的那个『丹』字，本就含着半成之丹。凝而不圆，也是丹。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "affix_count",
            "ref": "药",
            "count": 2
          },
          {
            "type": "var",
            "key": "rare_mat",
            "op": ">=",
            "value": 3
          }
        ]
      }
    }
  ],
  "forbidden": [

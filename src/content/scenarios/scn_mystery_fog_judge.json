{
  "id": "scn_mystery_fog_judge",
  "kind": "scenario",
  "name": "雾中判官",
  "pack": [
    "mystery"
  ],
  "span": 5,
  "tension": 7,
  "weight": 38,
  "requires": {
    "type": "realm_idx",
    "op": ">=",
    "value": 1
  },
  "leadup_motifs": [
    "m_playacting",
    "m_sealed_object"
  ],
  "rules_stated": [
    "入雾者须自陈其名，陈名而后，判官以名定罪。",
    "名正则行正，名邪则行邪——判官不看人，只看名。",
    "陈名之后不可改口，改口者魂飞。"
  ],
  "rules_hidden": [
    {
      "id": "rule_name_is_claim",
      "hint": "判官无从核验你的名。他判的其实是你陈名时那一口气——正邪全在口气里。",
      "reveal": {
        "type": "attr",
        "key": "charm",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_name_can_be_empty",
      "hint": "『名』不必是姓名。道号、绰号、庙号、乃至一个虚字，都算名——只要你自己认。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_voice_not_person",
      "hint": "『不可改口』禁的是同一口气改两次。换一个人替你陈，那口气就不是你的了。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "relation",
            "kind": "盟友",
            "exists": true
          },
          {
            "type": "relation",
            "kind": "护道人",
            "exists": true
          }
        ]
      }
    }
  ],
  "forbidden": [
    "陈名之后再吐第二句",
    "对判官行礼",
    "在雾中回头"
  ],
  "breakthroughs": [
    {

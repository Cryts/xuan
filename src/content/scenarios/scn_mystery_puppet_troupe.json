  "rules_stated": [
    "戏班七人，各掌一职，缺一人则戏不成。",
    "台上所演之事，台下必成真。",
    "看客不得上台——上台者，即为戏中之人。"
  ],
  "rules_hidden": [
    {
      "id": "rule_seven_are_one",
      "hint": "七人不是你遇见的七个人，是你身上的七样东西。杀一个，就是割自己一刀。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 46
      }
    },
    {
      "id": "rule_empty_seat",
      "hint": "看客席上那把椅子是空的。戏班从不给自己留座——那是留给戏里人的。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "var",
            "key": "corruption",
            "op": ">=",
            "value": 30
          },
          {
            "type": "attr",
            "key": "insight",
            "op": ">=",
            "value": 45
          }
        ]
      }
    },
    {

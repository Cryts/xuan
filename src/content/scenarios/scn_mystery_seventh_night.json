  "rules_stated": [
    "谶言曰：此宅之事，须在第七夜之前了结。",
    "宅中每夜你只可说一句话，言出不可收回。",
    "谶言所载之事，必成真。"
  ],
  "rules_hidden": [
    {
      "id": "rule_speech_needs_ear",
      "hint": "『一句话』数的是有人听见的话。对着空屋子自言自语，不算。",
      "reveal": {
        "type": "attr",
        "key": "insight",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_night_is_count",
      "hint": "『第七夜』记的不是天色，是话数——话到第七句，第七夜就到了。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 46
      }
    },
    {
      "id": "rule_blank_tail",
      "hint": "谶言只写了半句。『必成真』的唯有写下的那半句——没写的，是空的。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "affordance",
            "ref": "卜具"
          },
          {
            "type": "faction_tier",
            "ref": "观星台",
            "op": ">=",
            "value": 2
          }
        ]
      }
    }
  ],
  "forbidden": [

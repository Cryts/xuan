  "rules_stated": [
    "纪元清算之日，你每刻一枚骨篆，清算便进一分。",
    "刻满者即为纪元之敌，十方同诛。",
    "骨篆不可消，唯可覆刻。"
  ],
  "rules_hidden": [
    {
      "id": "rule_overwrite_anyone",
      "hint": "『覆刻』不必覆在自己骨上——你腕上的篆，可以覆到旁人身上。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "attr",
            "key": "wits",
            "op": ">=",
            "value": 46
          },
          {
            "type": "relation",
            "kind": "仇家",
            "exists": true
          }
        ]
      }
    },
    {
      "id": "rule_first_light",
      "hint": "清算按先来后到排位。先到者征得轻，末位者替所有人受这一纪。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 48
      }
    },
    {
      "id": "rule_blank_carving",
      "hint": "『刻满』数的是篆上的字数。空刻——无字之刻——不算数。",
      "reveal": {
        "type": "known_rule",
        "ref": "rule_first_light"
      }
    }
  ],
  "forbidden": [
    "覆刻于同族骨上",
    "毁去他人骨篆",
    "在清算之日开口求饶"

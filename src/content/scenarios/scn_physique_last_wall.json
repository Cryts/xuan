          {
            "type": "relation",
            "kind": "盟友",
            "exists": true
          }
        ]
      }
    },
    {
      "id": "rule_last_wave_empty",
      "hint": "最后一拨里没有活人——那是他拿来数你墙上还剩几个人的。你站得越满，他越不敢上。",
      "reveal": {

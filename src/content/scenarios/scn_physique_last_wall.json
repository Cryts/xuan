  "rules_stated": [
    "来的人分四拨，一拨重过一拨，中间不给你歇的时候。",
    "墙只有一面，人只有这些：拨去东边，西边就薄。",
    "撑到最后一拨退走，寨子就是你的；撑不到，寨子就没了。"
  ],
  "rules_hidden": [
    {
      "id": "rule_wall_is_people",
      "hint": "墙不是墙，是人：人先散，墙才塌。守的是人心，不是那道口子。",
      "reveal": {
        "type": "any",
        "of": [
          {

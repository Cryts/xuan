  "rules_stated": [
    "匣中投名，名即现形——所投何名，所得何物。",
    "所投之名须为一物之全名，名不全者，所现亦不全。",
    "一匣只认一面，一面只容一名。"
  ],
  "rules_hidden": [
    {
      "id": "rule_vague_is_whole",
      "hint": "『全名』——『万物』『诸般』也是一物的全名。名字越虚，出来的东西越实。",
      "reveal": {
        "type": "attr",
        "key": "wits",
        "op": ">=",
        "value": 46
      }
    },
    {
      "id": "rule_part_is_gift",
      "hint": "『不全』不是残缺。投『锋』得锋，投『鞘』得藏——你要哪一段，它给哪一段。",
      "reveal": {
        "type": "attr",
        "key": "insight",
        "op": ">=",
        "value": 45
      }
    },
    {
      "id": "rule_six_faces",
      "hint": "匣有六面，你只用了朝着你的那一面。",
      "reveal": {
        "type": "known_rule",
        "ref": "rule_vague_is_whole"
      }
    }
  ],
  "forbidden": [
    "以己之名投匣",
    "在匣前说出未投之名",
    "以他人之名代投"

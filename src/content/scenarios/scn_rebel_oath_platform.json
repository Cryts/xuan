{
  "id": "scn_rebel_oath_platform",
  "kind": "scenario",
  "name": "立契台",
  "pack": ["rebel"],
  "span": 5,
  "tension": 8,
  "weight": 38,
  "requires": { "type": "realm_idx", "op": ">=", "value": 2 },
  "rules_stated": [
    "台上斗法只论三事：先立契，后出招，不得越界。",
    "契以天地为证，违约者道心崩碎。",
    "所呼之名即所召之力，呼错者反噬己身。"
  ],
  "rules_hidden": [
    {
      "id": "rule_name_has_edge",
      "hint": "他呼『炎』，则炎外之物不受其制。所呼之名有边界，出了边界，他就没有招了。",
      "reveal": { "type": "attr", "key": "wits", "op": ">=", "value": 65 }
    },
    {
      "id": "rule_oath_names_two",
      "hint": "契上只写你我两个名字。第三人动手，不算违约。",
      "reveal": {
        "type": "any",
        "of": [
          { "type": "relation", "kind": "盟友", "exists": true },
          { "type": "attr", "key": "insight", "op": ">=", "value": 60 }
        ]
      }
    },
    {
      "id": "rule_oath_is_speech",
      "hint": "『先立契』——立契也是话，话也是招。契文怎么写，是你的先手。",
      "reveal": { "type": "known_rule", "ref": "rule_name_has_edge" }
    }
  ],
  "forbidden": [
    "在台上呼师门之名",
    "于契中提及第三人",
    "出招后补立契"
  ],
  "breakthroughs": [

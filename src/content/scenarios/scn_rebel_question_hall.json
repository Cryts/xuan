  "rules_stated": [
    "道场中死了一人，凶必在七人之中。",
    "断案只凭三样：物证、口供、镜中所见。",
    "断错者，与凶同罪。"
  ],
  "rules_hidden": [
    {
      "id": "rule_mirror_is_eyes",
      "hint": "镜中所见，是有人眼所见。镜中有空缺之处，那便是无人看着的时候。",
      "reveal": {
        "type": "attr",
        "key": "insight",
        "op": ">=",
        "value": 46
      }
    },
    {
      "id": "rule_word_can_be_lent",
      "hint": "『口供』只论其真，不论出于谁口——旁人代供，也是供。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "attr",
            "key": "charm",
            "op": ">=",
            "value": 45
          },
          {
            "type": "relation",
            "kind": "盟友",
            "exists": true
          }
        ]
      }
    },
    {
      "id": "rule_hand_not_owner",
      "hint": "『物证』只论在谁手中取出。不是你放的，也可以是你的。",
      "reveal": {
        "type": "known_rule",
        "ref": "rule_mirror_is_eyes"
      }
    }
  ],
  "forbidden": [
    "在道场中动武",
    "毁去天机镜",
    "向执法者自陈修为"
  ],

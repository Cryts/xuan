  "rules_stated": [
    "有人递了帖子来：三场连打，中间不下台——伤不治，气不回。",
    "他走的是「则」一路，你的「意」被他压着：硬拼是拼不过的。",
    "台下的人只记输赢，不记缘由：你欠下的，宗门替你还。"
  ],
  "rules_hidden": [
    {
      "id": "rule_duel_ways_rotate",
      "hint": "他一路「则」打到底，不是因为他强，是因为他不会第二条——他压的是你的路数，不是你的人。换一条路数，他就得重新认你。",
      "reveal": {
        "type": "any",
        "of": [
          {
            "type": "attr",
            "key": "wits",
            "op": ">=",
            "value": 45
          },
          {
            "type": "learned_rule",
            "pack": "mystery",
            "ref": "rule_mystery_name_veil"
          }
        ]
      }
    },
    {
      "id": "rule_duel_board_is_lie",
      "hint": "台上那块写明牌的木牌，是立给台下看的：牌上少写了一路，他把那一手藏在左手。",
      "reveal": {
        "type": "any",
